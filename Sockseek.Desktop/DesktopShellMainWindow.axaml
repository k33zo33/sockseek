<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:desktop="using:Sockseek.Desktop"
        x:Class="Sockseek.Desktop.DesktopShellMainWindow"
        Width="1280"
        Height="840"
        MinWidth="960"
        MinHeight="640"
        Title="{Binding WindowTitle}">
  <DockPanel Background="{DynamicResource ShellBackgroundBrush}" LastChildFill="True">
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsBackendBannerVisible}"
            Background="{DynamicResource ShellBannerHostBrush}"
            Padding="16"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding BackendBannerTitle}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding BackendBannerMessage}" TextWrapping="Wrap" Opacity="0.9" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsCommandPaletteOpen}"
            Background="{DynamicResource ShellCommandPaletteBrush}"
            Padding="16"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1">
      <StackPanel Spacing="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left"
                     Text="{Binding CommandPalette.Title}"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommandPaletteCommand}" />
        </DockPanel>

        <TextBlock Text="{Binding CommandPalette.Placeholder}" Opacity="0.75" />
        <ItemsControl ItemsSource="{Binding CommandPaletteButtons}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="desktop:DesktopShellCommandPaletteItemViewModel">
              <Button HorizontalAlignment="Stretch"
                      Content="{Binding DisplayLabel}"
                      Command="{Binding ExecuteCommand}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource ShellPlayerBarBrush}"
            Padding="16"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="10" Background="{DynamicResource ShellBadgeBrush}">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="♪" FontSize="24" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding PlayerBarTitle}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PlayerBarArtist}" Opacity="0.75" />
          <TextBlock Text="{Binding PlayerBarProgress}" Opacity="0.65" />
        </StackPanel>

        <ItemsControl Grid.Column="2" ItemsSource="{Binding PlayerBar.TransportActions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="desktop:DesktopPlayerBarActionViewModel">
              <Button MinWidth="52"
                      Content="{Binding IconGlyph}"
                      Command="{Binding Command}"
                      IsEnabled="{Binding IsEnabled}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding PlayerBar.UtilityActions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="desktop:DesktopPlayerBarActionViewModel">
                <Button MinWidth="52"
                        Content="{Binding IconGlyph}"
                        Command="{Binding Command}"
                        IsEnabled="{Binding IsEnabled}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock VerticalAlignment="Center"
                     Text="{Binding PlayerBarQueueSummary}"
                     Opacity="0.7"
                     TextWrapping="Wrap"
                     MaxWidth="280" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="260,*">
      <Border Grid.Column="0" Background="{DynamicResource ShellSidebarBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
              <TextBlock Text="Local-first desktop shell" Opacity="0.7" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Theme" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="System" Command="{Binding SetSystemThemeCommand}" />
                <Button Content="Light" Command="{Binding SetLightThemeCommand}" />
                <Button Content="Dark" Command="{Binding SetDarkThemeCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding CurrentTheme}" Opacity="0.75" />
            </StackPanel>

            <Button Content="Open command palette (Ctrl+K)" Command="{Binding OpenCommandPaletteCommand}" />

            <ItemsControl ItemsSource="{Binding NavigationButtons}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="desktop:DesktopShellNavigationItemViewModel">
                  <Button HorizontalAlignment="Stretch"
                          Content="{Binding DisplayLabel}"
                          Command="{Binding NavigateCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <ScrollViewer Grid.Column="1">
        <StackPanel Margin="24" Spacing="20">
          <Border Background="{DynamicResource ShellCardBrush}" CornerRadius="18" Padding="24">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
              <Border Grid.Column="0"
                      Width="72"
                      Height="72"
                      CornerRadius="18"
                      Background="{DynamicResource ShellBadgeBrush}"
                      VerticalAlignment="Top">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding CurrentPageBadgeLabel}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                            FontSize="14"
                           FontWeight="SemiBold"
                           Opacity="0.72"
                           Margin="10" />
              </Border>

              <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="{Binding CurrentPageTitle}" FontSize="32" FontWeight="Bold" />
                <TextBlock Text="{Binding CurrentPageDescription}" TextWrapping="Wrap" FontSize="16" Opacity="0.85" />
                <Border Background="{DynamicResource ShellCardAltBrush}" CornerRadius="12" Padding="14" Margin="0,8,0,0">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding CurrentPageEmptyStateTitle}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentPageEmptyStateDescription}" TextWrapping="Wrap" Opacity="0.82" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Border>

          <Border Background="{DynamicResource ShellCardBrush}" CornerRadius="14" Padding="20">
            <StackPanel Spacing="14">
              <TextBlock Text="{Binding PageHighlightsHeading}" FontSize="20" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding CurrentPageHighlights}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="desktop:ShellPageDetailItemViewModel">
                    <Border Background="{DynamicResource ShellCardAltBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.8" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource ShellCardBrush}"
                  CornerRadius="14"
                  Padding="20"
                  IsVisible="{Binding IsSearchWorkspaceVisible}">
            <StackPanel Spacing="12">
              <TextBlock Text="Search workspace" FontSize="20" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <RadioButton Content="Track" IsChecked="{Binding Search.IsTrackMode}" GroupName="SearchMode" />
                <RadioButton Content="Album" IsChecked="{Binding Search.IsAlbumMode}" GroupName="SearchMode" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <TextBox Grid.Column="0" Watermark="Artist" Text="{Binding Search.Artist}" />
                <TextBox Grid.Column="1" IsVisible="{Binding Search.IsTrackMode}" Watermark="Title" Text="{Binding Search.Title}" />
                <TextBox Grid.Column="1" IsVisible="{Binding Search.IsAlbumMode}" Watermark="Album" Text="{Binding Search.Album}" />
              </Grid>
              <TextBox IsVisible="{Binding Search.IsAlbumMode}" Watermark="Track hint (optional)" Text="{Binding Search.SearchHint}" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <TextBox Grid.Column="0" Watermark="Profile names" Text="{Binding Search.ProfileNames}" />
                <TextBox Grid.Column="1" Watermark="Minimum bitrate" Text="{Binding Search.MinBitrate}" />
                <TextBox Grid.Column="2" Watermark="Formats" Text="{Binding Search.Formats}" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Search" Command="{Binding Search.SearchCommand}" />
                <Button Content="Refresh results" Command="{Binding Search.RefreshResultsCommand}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Search.ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Text="{Binding Search.ResultsRevision, StringFormat='Revision {0}'}" Opacity="0.7" />
              <ListBox ItemsSource="{Binding Search.FileCandidates}"
                       MaxHeight="420"
                       Background="Transparent"
                       BorderThickness="0"
                       SelectionMode="Single">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="desktop:DesktopFileCandidateViewModel">
                    <Border Background="{DynamicResource ShellCardAltBrush}" Padding="10" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="4">
                          <TextBlock Text="{Binding Filename}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Username, StringFormat='user {0}'}" Opacity="0.75" />
                          <TextBlock Text="{Binding MetadataSummary}" TextWrapping="Wrap" Opacity="0.75" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Download" Command="{Binding DataContext.Search.DownloadFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <ListBox ItemsSource="{Binding Search.FolderCandidates}"
                       MaxHeight="420"
                       Background="Transparent"
                       BorderThickness="0"
                       SelectionMode="Single">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="desktop:DesktopAlbumFolderViewModel">
                    <Border Background="{DynamicResource ShellCardAltBrush}" Padding="10" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="4">
                          <TextBlock Text="{Binding FolderPath}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Username, StringFormat='user {0}'}" Opacity="0.75" />
                          <TextBlock Text="{Binding MetadataSummary}" TextWrapping="Wrap" Opacity="0.75" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Download" Command="{Binding DataContext.Search.DownloadFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource ShellCardBrush}"
                  CornerRadius="14"
                  Padding="20"
                  IsVisible="{Binding IsDownloadsQueueVisible}">
            <StackPanel Spacing="12">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Download queue" FontSize="20" FontWeight="SemiBold" />
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding Downloads.RefreshCommand}" />
              </DockPanel>
              <TextBlock Text="{Binding Downloads.ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Downloads.Notifications}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="desktop:DesktopNotificationViewModel">
                    <Border Background="{DynamicResource ShellCardAltBrush}" Padding="10" Margin="0,0,0,6">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.75" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Downloads.Progress}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="4" Margin="0,0,0,8">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Live transfer" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding BytesTransferred, StringFormat='{}{0} / {1} bytes'}" Opacity="0.75" />
                      </DockPanel>
                      <TextBlock Text="Transfer progress received from daemon" Opacity="0.7" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Downloads.Jobs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource ShellCardAltBrush}" Padding="10" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                        <StackPanel>
                          <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding LifecycleState}" Opacity="0.75" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ActivityPhase}" Opacity="0.75" />
                        <Button Grid.Column="2" Content="Next candidate" Command="{Binding DataContext.Downloads.NextCandidateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding JobId}" />
                        <Button Grid.Column="3" Content="Retry" Command="{Binding DataContext.Downloads.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding JobId}" />
                        <Button Grid.Column="4" Content="Details" Command="{Binding DataContext.Downloads.LoadWorkflowTreeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        <Button Grid.Column="5" Content="Open file" Command="{Binding DataContext.Downloads.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding JobId}" />
                        <Button Grid.Column="6" Content="Open folder" Command="{Binding DataContext.Downloads.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding JobId}" />
                        <Button Grid.Column="7" Content="Cancel" Command="{Binding DataContext.Downloads.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding JobId}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Spacing="8" IsVisible="{Binding Downloads.IsWorkflowTreeVisible}">
                <TextBlock Text="{Binding Downloads.SelectedWorkflowTitle}" FontSize="18" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Downloads.SelectedWorkflowNodes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="desktop:DesktopWorkflowTreeNodeViewModel">
                      <StackPanel Spacing="2" Margin="0,0,0,4">
                        <TextBlock Text="{Binding DisplayLabel}" FontFamily="Consolas, Cascadia Mono, monospace" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FailureMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource ShellCardBrush}"
                  CornerRadius="14"
                  Padding="20"
                  IsVisible="{Binding IsLibraryVisible}">
            <StackPanel Spacing="12">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Local library" FontSize="20" FontWeight="SemiBold" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                  <Button Content="Refresh roots" Command="{Binding Library.RefreshRootsCommand}" />
                  <Button Content="Scan" Command="{Binding Library.ScanCommand}" />
                </StackPanel>
              </DockPanel>
              <TextBlock Text="{Binding Library.ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Library.ScanSummary}" Opacity="0.75" />
              <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="10">
                <TextBox Grid.Column="0" Watermark="Root path" Text="{Binding Library.RootPath}" />
                <TextBox Grid.Column="1" Watermark="Display name" Text="{Binding Library.RootDisplayName}" />
                <Button Grid.Column="2" Content="Save root" Command="{Binding Library.SaveRootCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Library.Roots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource ShellCardAltBrush}" Padding="10" Margin="0,0,0,6">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Opacity="0.75" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                <TextBox Grid.Column="0" Watermark="Search local tracks" Text="{Binding Library.SearchText}" />
                <CheckBox Grid.Column="1" Content="Include missing" IsChecked="{Binding Library.IncludeMissing}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Search" Command="{Binding Library.SearchCommand}" />
                <Button Grid.Column="3" Content="Duplicates" Command="{Binding Library.RefreshDuplicatesCommand}" />
              </Grid>
              <TextBlock Text="{Binding Library.TotalTrackCount, StringFormat='{}{0} tracks'}" Opacity="0.75" />
              <ListBox ItemsSource="{Binding Library.Tracks}"
                       MaxHeight="420"
                       Background="Transparent"
                       BorderThickness="0"
                       SelectionMode="Single">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="desktop:DesktopLibraryTrackViewModel">
                    <Border Background="{DynamicResource ShellCardAltBrush}" Padding="10" Margin="0,0,0,6">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Artist}" Opacity="0.75" />
                        <TextBlock Text="{Binding AvailabilitySummary}" Opacity="0.75" />
                        <TextBlock Text="{Binding TechnicalSummary}" Opacity="0.75" />
                        <TextBlock Text="{Binding BestPath}" TextWrapping="Wrap" Opacity="0.65" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <ItemsControl ItemsSource="{Binding Library.DuplicateGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="desktop:DesktopLibraryDuplicateGroupViewModel">
                    <Border Background="{DynamicResource ShellCardAltBrush}" Padding="10" Margin="0,0,0,6">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FileSummary}" Opacity="0.75" />
                        <ItemsControl ItemsSource="{Binding Paths}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding}" TextWrapping="Wrap" Opacity="0.65" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource ShellCardBrush}"
                  CornerRadius="14"
                  Padding="20"
                  IsVisible="{Binding IsHomeSectionActive}">
            <StackPanel Spacing="14">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding HomeSummaryTitle}"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <Border DockPanel.Dock="Right"
                        Background="{DynamicResource ShellBadgeBrush}"
                        CornerRadius="999"
                        Padding="10,4">
                  <TextBlock Text="{Binding HomeLiveDataBadge}" FontSize="12" FontWeight="Bold" />
                </Border>
              </DockPanel>
              <TextBlock Text="{Binding HomeSummaryDescription}" TextWrapping="Wrap" Opacity="0.8" />
              <ItemsControl ItemsSource="{Binding HomeSummaryFacts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="desktop:HomeSummaryFactViewModel">
                    <Border Background="{DynamicResource ShellCardAltBrush}" CornerRadius="12" Padding="16" Margin="0,0,10,10">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" Opacity="0.75" />
                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource ShellCardBrush}" CornerRadius="14" Padding="20">
            <StackPanel Spacing="10">
              <TextBlock Text="Daemon status" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding BackendState}" />
              <TextBlock Text="{Binding DiagnosticsText}" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,Monospace" Opacity="0.8" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button HorizontalAlignment="Left"
                        IsEnabled="{Binding CanStartDaemon}"
                        Content="{Binding StartDaemonLabel}"
                        Command="{Binding StartDaemonCommand}" />
                <Button HorizontalAlignment="Left"
                        IsVisible="{Binding CanCopyDiagnostics}"
                        Content="{Binding CopyDiagnosticsLabel}"
                        Click="HandleCopyDiagnosticsClick" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
