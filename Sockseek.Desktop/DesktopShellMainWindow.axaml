<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sockseek.Desktop.DesktopShellMainWindow"
        Width="1280"
        Height="840"
        MinWidth="960"
        MinHeight="640"
        Title="{Binding WindowTitle}">
  <DockPanel Background="#11151C" LastChildFill="True">
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsBackendBannerVisible}"
            Background="#1D2633"
            Padding="16"
            BorderBrush="#2C3B52"
            BorderThickness="0,0,0,1">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding BackendBannerTitle}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding BackendBannerMessage}" TextWrapping="Wrap" Opacity="0.9" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsCommandPaletteOpen}"
            Background="#151B25"
            Padding="16"
            BorderBrush="#2C3B52"
            BorderThickness="0,0,0,1">
      <StackPanel Spacing="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left"
                     Text="{Binding CommandPalette.Title}"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <Button DockPanel.Dock="Right" Content="Close" Click="HandleCloseCommandPaletteClick" />
        </DockPanel>

        <TextBlock Text="{Binding CommandPalette.Placeholder}" Opacity="0.75" />
        <StackPanel x:Name="CommandPaletteItemsHost" Spacing="8" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="#151B25"
            Padding="16"
            BorderBrush="#2C3B52"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="16">
        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="10" Background="#253246">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="♪" FontSize="24" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding PlayerBarTitle}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PlayerBarArtist}" Opacity="0.75" />
          <TextBlock Text="{Binding PlayerBarProgress}" Opacity="0.65" />
        </StackPanel>

        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="⏮" FontSize="20" />
        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="⏯" FontSize="20" />
        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="⏭" FontSize="20" />
        <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{Binding PlayerBarQueueSummary}" Opacity="0.7" TextWrapping="Wrap" MaxWidth="280" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="260,*">
      <Border Grid.Column="0" Background="#161D28" BorderBrush="#2C3B52" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
              <TextBlock Text="Local-first desktop shell" Opacity="0.7" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Theme" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="System" Click="HandleSystemThemeClick" />
                <Button Content="Light" Click="HandleLightThemeClick" />
                <Button Content="Dark" Click="HandleDarkThemeClick" />
              </StackPanel>
              <TextBlock Text="{Binding CurrentTheme}" Opacity="0.75" />
            </StackPanel>

            <Button Content="Open command palette (Ctrl+K)" Click="HandleOpenCommandPaletteClick" />

            <StackPanel x:Name="NavigationItemsHost" Spacing="8" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <ScrollViewer Grid.Column="1">
        <StackPanel Margin="24" Spacing="20">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding CurrentPageTitle}" FontSize="32" FontWeight="Bold" />
            <TextBlock Text="{Binding CurrentPageDescription}" TextWrapping="Wrap" FontSize="16" Opacity="0.85" />
          </StackPanel>

          <Border Background="#182130" CornerRadius="14" Padding="20">
            <StackPanel Spacing="10">
              <TextBlock Text="Daemon status" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding BackendState}" />
              <TextBlock Text="{Binding DiagnosticsText}" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,Monospace" Opacity="0.8" />
              <Button HorizontalAlignment="Left"
                      IsEnabled="{Binding CanStartDaemon}"
                      Content="{Binding StartDaemonLabel}"
                      Click="HandleStartDaemonClick" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
