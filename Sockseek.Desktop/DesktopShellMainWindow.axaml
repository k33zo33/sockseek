<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:desktop="using:Sockseek.Desktop"
        x:Class="Sockseek.Desktop.DesktopShellMainWindow"
        Width="1280"
        Height="840"
        MinWidth="960"
        MinHeight="640"
        Title="{Binding WindowTitle}">
  <DockPanel Background="#11151C" LastChildFill="True">
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsBackendBannerVisible}"
            Background="#1D2633"
            Padding="16"
            BorderBrush="#2C3B52"
            BorderThickness="0,0,0,1">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding BackendBannerTitle}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding BackendBannerMessage}" TextWrapping="Wrap" Opacity="0.9" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsCommandPaletteOpen}"
            Background="#151B25"
            Padding="16"
            BorderBrush="#2C3B52"
            BorderThickness="0,0,0,1">
      <StackPanel Spacing="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left"
                     Text="{Binding CommandPalette.Title}"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommandPaletteCommand}" />
        </DockPanel>

        <TextBlock Text="{Binding CommandPalette.Placeholder}" Opacity="0.75" />
        <ItemsControl ItemsSource="{Binding CommandPaletteButtons}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="desktop:DesktopShellCommandPaletteItemViewModel">
              <Button HorizontalAlignment="Stretch"
                      Content="{Binding DisplayLabel}"
                      Command="{Binding ExecuteCommand}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="#151B25"
            Padding="16"
            BorderBrush="#2C3B52"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="10" Background="#253246">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="♪" FontSize="24" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding PlayerBarTitle}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PlayerBarArtist}" Opacity="0.75" />
          <TextBlock Text="{Binding PlayerBarProgress}" Opacity="0.65" />
        </StackPanel>

        <ItemsControl Grid.Column="2" ItemsSource="{Binding PlayerBar.TransportActions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="desktop:DesktopPlayerBarActionViewModel">
              <Button MinWidth="52"
                      Content="{Binding IconGlyph}"
                      Command="{Binding Command}"
                      IsEnabled="{Binding IsEnabled}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding PlayerBar.UtilityActions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="desktop:DesktopPlayerBarActionViewModel">
                <Button MinWidth="52"
                        Content="{Binding IconGlyph}"
                        Command="{Binding Command}"
                        IsEnabled="{Binding IsEnabled}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock VerticalAlignment="Center"
                     Text="{Binding PlayerBarQueueSummary}"
                     Opacity="0.7"
                     TextWrapping="Wrap"
                     MaxWidth="280" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="260,*">
      <Border Grid.Column="0" Background="#161D28" BorderBrush="#2C3B52" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
              <TextBlock Text="Local-first desktop shell" Opacity="0.7" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Theme" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="System" Command="{Binding SetSystemThemeCommand}" />
                <Button Content="Light" Command="{Binding SetLightThemeCommand}" />
                <Button Content="Dark" Command="{Binding SetDarkThemeCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding CurrentTheme}" Opacity="0.75" />
            </StackPanel>

            <Button Content="Open command palette (Ctrl+K)" Command="{Binding OpenCommandPaletteCommand}" />

            <ItemsControl ItemsSource="{Binding NavigationButtons}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="desktop:DesktopShellNavigationItemViewModel">
                  <Button HorizontalAlignment="Stretch"
                          Content="{Binding DisplayLabel}"
                          Command="{Binding NavigateCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <ScrollViewer Grid.Column="1">
        <StackPanel Margin="24" Spacing="20">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding CurrentPageTitle}" FontSize="32" FontWeight="Bold" />
            <TextBlock Text="{Binding CurrentPageDescription}" TextWrapping="Wrap" FontSize="16" Opacity="0.85" />
          </StackPanel>

          <Border Background="#182130" CornerRadius="14" Padding="20">
            <StackPanel Spacing="10">
              <TextBlock Text="Daemon status" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding BackendState}" />
              <TextBlock Text="{Binding DiagnosticsText}" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,Monospace" Opacity="0.8" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button HorizontalAlignment="Left"
                        IsEnabled="{Binding CanStartDaemon}"
                        Content="{Binding StartDaemonLabel}"
                        Command="{Binding StartDaemonCommand}" />
                <Button HorizontalAlignment="Left"
                        IsVisible="{Binding CanCopyDiagnostics}"
                        Content="{Binding CopyDiagnosticsLabel}"
                        Click="HandleCopyDiagnosticsClick" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
